# What access-argocd provisions for a REMOTE Argo CD: a kubeconfig for that
# cluster. cluster-version must not use it for the local lookup.
apiVersion: v1
kind: Config
current-context: argocd
contexts:
- name: argocd
  context: {cluster: argocd, user: kargo-promotion-argocd}
clusters:
- name: argocd
  cluster: {server: "https://argocd-cluster.example.com"}
users:
- name: kargo-promotion-argocd
  user: {token: remote-token}
